# Server-side only. Never commit a real key. Never expose to the client.
# The key must be an OpenAI API key from platform.openai.com/api-keys —
# a ChatGPT subscription (Plus/Pro) does NOT include API access; the API
# is billed separately (prepaid, $5 minimum credit purchase).
LLM_API_KEY=
# gpt-4o-mini: $0.15 in / $0.60 out per 1M tokens, fast, proven tool
# calling. ~$0.0005 per coach turn — $5 of credit covers ~10,000 turns.
# Alternative: gpt-5-nano ($0.05/$0.40), cheapest, but less proven for
# the tool-calling loop. Don't use gpt-4o or gpt-5 here — 10x the price,
# slower, no benefit for grounded Q&A.
LLM_MODEL=gpt-4o-mini
# Daily cap on live model calls (per server instance). After it, the coach
# answers from the labelled rule-based fallback. Default 300 (~$0.15/day).
COACH_DAILY_LIMIT=300

# Demo auth (one seeded user). Sign-in FAILS CLOSED: nobody can sign in
# until all three are set. DEMO_PASS must be 12+ characters and not the old
# template default. Set the same three in Vercel (Production) before deploying.
DEMO_USER=demo
DEMO_PASS=
# 32+ random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
